@model portfolio.Models.Project
@{
    ViewData["Title"] = Model.Title;
}

<div class="project-detail">

    <!-- BACK + HEADER -->
    <div class="detail-header">
        <div class="container">
            <a href="/#projects" class="back-link">← Back to projects</a>
            <div class="detail-meta">
                <span class="project-category">@Model.Category</span>
            </div>
            <h1 class="detail-title">@Model.Title</h1>
            <p class="detail-short">@Model.ShortDescription</p>

            <div class="detail-actions">
                <a href="@Model.GitHubUrl" class="btn-primary" target="_blank" rel="noopener noreferrer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-3px;margin-right:6px"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                    View on GitHub
                </a>
            </div>
        </div>
    </div>

    <!-- IMAGE GALLERY -->
    @if (Model.ImagePaths.Count > 0)
    {
        <div class="gallery-section">
            <div class="container">
                <div class="gallery @(Model.ImagePaths.Count == 1 ? "gallery--single" : "")">
                    @foreach (var img in Model.ImagePaths)
                    {
                        <div class="gallery-item" onclick="openLightbox('@img')">
                            <img src="@img" alt="@Model.Title screenshot" loading="lazy" />
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- CONTENT -->
    <div class="detail-body">
        <div class="container detail-body-grid">

            <!-- DESCRIPTION -->
            <div class="detail-description">
                <h2>About this project</h2>
                @foreach (var para in Model.FullDescription.Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
                {
                    <p>@para.Trim()</p>
                }
            </div>

            <!-- SIDEBAR -->
            <aside class="detail-sidebar">
                <div class="sidebar-block">
                    <h3>Tech Stack</h3>
                    <div class="stack-tags">
                        @foreach (var tech in Model.TechStack.Split(','))
                        {
                            <span class="tag">@tech.Trim()</span>
                        }
                    </div>
                </div>

                @if (Model.Features.Count > 0)
                {
                    <div class="sidebar-block">
                        <h3>Key Features</h3>
                        <ul class="features-list">
                            @foreach (var feature in Model.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>
                    </div>
                }

                <div class="sidebar-block">
                    <h3>Repository</h3>
                    <a href="@Model.GitHubUrl" class="github-link" target="_blank" rel="noopener noreferrer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                        @Model.GitHubUrl.Replace("https://github.com/", "")
                    </a>
                </div>
            </aside>
        </div>
    </div>
</div>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" onclick="closeLightbox()">
    <button class="lightbox-close" onclick="closeLightbox()">✕</button>
    <img id="lightbox-img" src="" alt="Project screenshot enlarged" />
</div>
